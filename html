    // Highlight active stage tab button
    function updateStageTabs(activeStage) {
      for (let i = 1; i <= 5; i++) {
        const btn = document.getElementById(`tabStage${i}`);
        if (!btn) continue;
        if (i === activeStage) {
          btn.className = "stage-btn px-2.5 py-1 rounded-md text-[11px] font-mono font-bold bg-amber-500 text-slate-950 border border-amber-400 shadow-md shadow-amber-500/20";
        } else {
          btn.className = "stage-btn px-2.5 py-1 rounded-md text-[11px] font-mono font-semibold bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 hover:border-amber-400/50 transition active:scale-95";
        }
      }
    }

    // Trigger strike execution
    function triggerSpecificStrike(stageNumber, callback) {
      if (isStriking) return;
      isStriking = true;
      currentStrike = stageNumber;
      updateStageTabs(stageNumber);

      const data = strikeData[stageNumber];
      const upperDie = document.getElementById('upperDieAssembly');
      const planchet = document.getElementById('planchetCoin');
      const planchetSurface = document.getElementById('planchetSurface');
      const shockwave = document.getElementById('shockwaveRing');
      const pressStatus = document.getElementById('pressStatus');
      const pressureGauge = document.getElementById('pressureGauge');
      const narratorLine = document.getElementById('narratorLine');
      const laserBeam = document.getElementById('laserBeam');

      // Update UI Status
      pressStatus.textContent = `COMPRESSING: ${data.stage.toUpperCase()}`;
      pressStatus.classList.add('text-amber-400');
      pressureGauge.textContent = data.pressure;
      narratorLine.textContent = data.narrative;

      // Start Mechanical Motion
      upperDie.classList.add('strike-anim');
      planchet.classList.add('squash-anim');

      // Update Lower Die Void to Show Failure Progression
      const dieVoid = document.getElementById('dieVoidAnomaly');
      dieVoid.setAttribute('d', data.dieVoidPath);
      dieVoid.setAttribute('stroke-width', data.dieStrokeWidth || '0');
      dieVoid.setAttribute('fill', data.dieColor);

      // Mid-Strike Impact Event (At ~1.05s)
      setTimeout(() => {
        playSoundEffect('clank');
        shockwave.classList.remove('shock-anim');
        void shockwave.offsetWidth; // Reflow
        shockwave.classList.add('shock-anim');

        // Transform planchet into struck reverse coin
        planchetSurface.innerHTML = `
          <div class="text-[9px] font-bold text-slate-800 text-center uppercase tracking-tighter">
            ${data.stage.split(':')[0]}<br><span class="text-amber-700">STRUCK</span>
          </div>
        `;
      }, 1050);

      // Post-Strike Ejection & Serialization Scanning (~2.5s)
      setTimeout(() => {
        upperDie.classList.remove('strike-anim');
        planchet.classList.remove('squash-anim');
        isStriking = false;
        pressStatus.textContent = `EJECTED & CATALOGED: ${data.code}`;
        pressStatus.classList.remove('text-amber-400');

        // Update Struck Ejected Coin Details
        updateEjectedCoinCard(data);

        // Run Non-contact Optical Sensor Inspection Beam
        laserBeam.classList.remove('hidden');
        playSoundEffect('beep');
        setTimeout(() => laserBeam.classList.add('hidden'), 1700);

        if (callback) callback();
      }, 2500);
    }

    function updateEjectedCoinCard(data) {
      document.getElementById('badgeStage').textContent = data.stage;
      document.getElementById('serialDisplay').textContent = data.code;
      
      const ejectedAnomaly = document.getElementById('ejectedAnomaly');
      ejectedAnomaly.setAttribute('d', data.ejectedPath);
      ejectedAnomaly.setAttribute('fill', data.ejectedFill);
      ejectedAnomaly.setAttribute('stroke', data.ejectedStroke);
      ejectedAnomaly.setAttribute('stroke-width', data.ejectedStrokeWidth);
      ejectedAnomaly.setAttribute('opacity', data.ejectedOpacity);

      // Append to Twisted Penny Forensic Die Registry
      const ledger = document.getElementById('ledgerEntries');
      const entry = document.createElement('div');
      entry.className = "bg-slate-950 p-2 rounded border border-slate-800 flex items-center justify-between hover:border-amber-500/30 transition text-slate-200 animate-fade-in";
      entry.innerHTML = `
        <div class="flex items-center gap-2">
          <span class="text-amber-400 font-bold">${data.code}</span>
          <span class="text-slate-400 text-[10px]">(${data.stage.split(':')[1].trim()})</span>
        </div>
        <span class="text-emerald-400 font-semibold text-[10px]">VERIFIED CoP</span>
      `;
      ledger.prepend(entry);
    }

    // Play All 5 Stages in Continuous Sequence
    document.getElementById('btnPlaySequence').addEventListener('click', () => {
      if (isPlayingSequence) return;
      isPlayingSequence = true;
      document.getElementById('playText').textContent = "Running 5-Stage Sequence...";
      document.getElementById('btnPlaySequence').classList.add('opacity-75');

      function runNextStage(stageNum) {
        if (stageNum > 5) {
          isPlayingSequence = false;
          document.getElementById('playText').textContent = "Replay All 5 Stages";
          document.getElementById('btnPlaySequence').classList.remove('opacity-75');
          document.getElementById('narratorLine').textContent = 
            "Twisted Penny Commercial Complete: You have witnessed the complete 5-stage mechanical death of the 2026-P Mayflower die, curated by Founder David James, documented by Secretary Didi, and authenticated under the Twisted Penny Forensic Die Registry.";
          return;
        }
        triggerSpecificStrike(stageNum, () => {
          setTimeout(() => runNextStage(stageNum + 1), 1300);
        });
      }

      runNextStage(1);
    });

    function simulateCrowdsourceIntake() {
      const crowdSerials = ['PL-CROWD-089', 'PL-CROWD-142', 'PL-CROWD-203', 'PL-CROWD-311'];
      const randomSerial = crowdSerials[Math.floor(Math.random() * crowdSerials.length)];
      const locations = ['Austin, TX', 'Philadelphia, PA', 'Houma, LA', 'Orlando, FL'];
      const randomLoc = locations[Math.floor(Math.random() * locations.length)];

      playSoundEffect('beep');

      const ledger = document.getElementById('ledgerEntries');
      const entry = document.createElement('div');
      entry.className = "bg-amber-950/20 p-2 rounded border border-amber-500/40 flex items-center justify-between text-slate-200";
      entry.innerHTML = `
        <div class="flex items-center gap-1.5">
          <span class="text-amber-300 font-bold">${randomSerial}</span>
          <span class="text-slate-400 text-[10px]">[Crowdsource find: ${randomLoc}]</span>
        </div>
        <span class="text-amber-400 font-semibold text-[10px]">DIE MATCH CONFIRMED</span>
      `;
      ledger.prepend(entry);

      document.getElementById('narratorLine').textContent = 
        `Global Crowdsource Match Verified! A 2026-P Mayflower uploaded from ${randomLoc} confirmed the fixed die scratch through 'AMERICA'. Assigned ${randomSerial}. Registered in the Twisted Penny Forensic Die Registry!`;
    }
  </script>
