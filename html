  <script>
    // State Architecture
    let currentStrike = 0;
    let isStriking = false;
    let isPlayingSequence = false;
    let soundEnabled = true;

    // Web Audio Synthesizer
    let audioCtx = null;

    function initAudio() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
    }

    function playSoundEffect(type) {
      if (!soundEnabled) return;
      try {
        initAudio();
        const now = audioCtx.currentTime;

        if (type === 'clank') {
          // Deep mechanical hydraulic slam
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(145, now);
          osc.frequency.exponentialRampToValueAtTime(30, now + 0.38);
          gain.gain.setValueAtTime(0.85, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.38);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now);
          osc.stop(now + 0.38);
        } else if (type === 'beep') {
          // Non-contact optical diagnostic scan
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(920, now);
          osc.frequency.setValueAtTime(1840, now + 0.08);
          gain.gain.setValueAtTime(0.3, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.22);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now);
          osc.stop(now + 0.22);
        }
      } catch (e) {
        console.log("Audio awaiting user interaction");
      }
    }

    // Toggle Sound Button
    document.getElementById('btnSoundToggle').addEventListener('click', () => {
      soundEnabled = !soundEnabled;
      document.getElementById('btnSoundToggle').textContent = soundEnabled ? '🔊 Sound FX' : '🔇 Muted';
      document.getElementById('btnSoundToggle').classList.toggle('text-slate-400', !soundEnabled);
      document.getElementById('btnSoundToggle').classList.toggle('text-slate-300', soundEnabled);
    });

    // Complete 5-Stage Canonical Die Failure Progression Data
    const strikeData = {
      1: {
        stage: 'Stage I: Inception',
        code: 'PL-2026-P-I-014',
        pressure: '71.6',
        narrative: "Twisted Penny Commercial — Strike 1 (Inception): The press slams down. A microscopic hairline stress crack opens in the tool steel along the foresail anchor step. Natural mint fatigue—zero laser alteration.",
        dieVoidPath: "M 36 8 L 34 10",
        dieStrokeWidth: "0.8",
        dieColor: "#ef4444",
        ejectedPath: "M 36 43 L 34 45",
        ejectedOpacity: "1",
        ejectedFill: "#334155",
        ejectedStroke: "#1e293b",
        ejectedStrokeWidth: "0.8"
      },
