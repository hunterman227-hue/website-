  <style>
    @keyframes hydraulicPiston {
      0% { transform: translateY(0px); }
      38% { transform: translateY(96px); }
      52% { transform: translateY(98px); }
      68% { transform: translateY(0px); }
      100% { transform: translateY(0px); }
    }
    @keyframes planchetSquash {
      0% { transform: scale(1, 1); filter: drop-shadow(0 4px 6px rgba(0,0,0,0.5)); }
      40% { transform: scale(1.09, 0.52); filter: brightness(1.65) drop-shadow(0 0 16px rgba(251,191,36,0.9)); }
      60% { transform: scale(1, 1); filter: brightness(1); }
      100% { transform: scale(1, 1); }
    }
    @keyframes flashShockwave {
      0% { opacity: 0; transform: scale(0.5); }
      45% { opacity: 1; transform: scale(1.35); }
      100% { opacity: 0; transform: scale(2.2); }
    }
    @keyframes laserSweep {
      0% { top: 4%; opacity: 0; }
      20% { opacity: 1; }
      80% { opacity: 1; }
      100% { top: 96%; opacity: 0; }
    }
    .laser-line {
      animation: laserSweep 2s ease-in-out infinite alternate;
    }
    .strike-anim {
      animation: hydraulicPiston 2.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
    .squash-anim {
      animation: planchetSquash 2.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
    .shock-anim {
      animation: flashShockwave 0.75s ease-out forwards;
    }
  </style>
